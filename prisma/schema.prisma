generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  service_id    Int?
  slot_datetime DateTime  @db.Timestamp(6)
  status        String    @default("confirmed")
  booking_ref   String    @unique
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  guest_name    String?
  guest_phone   String?
  guest_email   String?
  duration_min  Int?      @default(60)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  services      services? @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([slot_datetime, status], map: "idx_appointments_slot")
  @@index([user_id, status], map: "idx_appointments_user")
}

model blocked_keywords {
  id      Int     @id @default(autoincrement())
  keyword String  @unique
  reason  String?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_history {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  role       String
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_chat_history_user")
}

model message_usage {
  user_id    Int
  usage_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  count      Int      @default(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, usage_date])
}

model services {
  id           Int            @id @default(autoincrement())
  name         String
  category     String
  description  String?
  price        Decimal        @db.Decimal(10, 2)
  duration_min Int?           @default(60)
  is_active    Boolean?       @default(true)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  appointments appointments[]

  @@index([category, is_active], map: "idx_services_category")
}

model users {
  id            Int             @id @default(autoincrement())
  line_user_id  String?         @unique
  display_name  String          @default("Guest")
  picture_url   String?
  session_id    String?         @unique
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  email         String?         @unique
  password_hash String?
  phone         String?
  id_number     String?
  is_registered Boolean         @default(false)
  appointments  appointments[]
  chat_history  chat_history[]
  message_usage message_usage[]

  @@index([email], map: "idx_users_email")
  @@index([phone], map: "idx_users_phone")
}
